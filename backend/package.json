{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "Gabriel Aguiar",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "check": "biome check src test",
    "format": "biome format --write src test",
    "lint": "biome lint src test",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/src/main",
    "test": "cross-env NODE_ENV=test jest",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPattern=test/unit",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPattern=test/integration --maxWorkers=1",
    "test:watch": "cross-env NODE_ENV=test jest --watch --maxWorkers=1",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "test:debug": "cross-env NODE_ENV=test node --inspect-brk -r tsconfig-paths/register ../node_modules/.bin/jest -r ts-node/register node_modules",
    "test:e2e": "cross-env NODE_ENV=test jest --testPathPattern=test/e2e --maxWorkers=1",
    "typeorm": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/shared/infra/database/typeorm-datasource.ts",
    "migration:generate": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register ../node_modules/typeorm/cli.js migration:generate -d src/shared/infra/database/typeorm-datasource.ts",
    "migration:run": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register ../node_modules/typeorm/cli.js migration:run -d src/shared/infra/database/typeorm-datasource.ts",
    "migration:revert": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register ../node_modules/typeorm/cli.js migration:revert -d src/shared/infra/database/typeorm-datasource.ts",
    "prod:migration:generate": "cross-env NODE_ENV=production ../node_modules/.bin/typeorm migration:generate -d dist/src/shared/infra/database/typeorm-datasource.js",
    "prod:migration:run": "cross-env NODE_ENV=production node ../node_modules/typeorm/cli.js migration:run -d dist/src/shared/infra/database/typeorm-datasource.js",
    "prod:migration:revert": "cross-env NODE_ENV=production node ../node_modules/typeorm/cli.js migration:revert -d dist/src/shared/infra/database/typeorm-datasource.js",
    "prod:seed:superuser": "cross-env NODE_ENV=production node dist/src/shared/infra/database/seeds/superuser.bootstrap.js",
    "reset:test": "rm -f test.sqlite && npm run migration:run && npm run test:seed",
    "seed": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/shared/infra/database/seeds/main.seed.ts",
    "seed:superuser": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/shared/infra/database/seeds/superuser.bootstrap.ts",
    "generate:spec": "cross-env NODE_ENV=spec JWT_SECRET=spec-only MAILERSEND_API_KEY=spec-only EMAIL_FROM=spec@spec.com ts-node -r tsconfig-paths/register src/generate-spec.ts"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@fastify/cookie": "^10.0.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^12.0.1",
    "@types/passport": "^1.0.17",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "mailersend": "^3.4.0",
    "nestjs-pino": "^5.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "typeorm-naming-strategies": "^4.1.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "jest": "^30.5.1",
    "pg-mem": "^3.0.14",
    "source-map-support": "^0.5.21",
    "sqlite3": "^6.0.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
